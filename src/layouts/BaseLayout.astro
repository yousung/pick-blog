---
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL, NAV_ITEMS, GA_MEASUREMENT_ID, NAVER_SITE_VERIFICATION, GOOGLE_SITE_VERIFICATION } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  canonical?: string;
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  canonical: canonicalOverride,
  noindex = false
} = Astro.props as Props;

const site = Astro.site ?? new URL(SITE_URL);
const canonical = canonicalOverride ?? new URL(Astro.url.pathname, site).href;
const pageTitle = title === SITE_TITLE ? `${SITE_TITLE} — 고르기 전에 보는 상품 노트` : `${title} | ${SITE_TITLE}`;
const imageUrl = new URL(image, site);
const robots = noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large';
const path = Astro.url.pathname;
const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical,
      inLanguage: 'ko-KR',
      author: { '@type': 'Person', name: '감성개발자' },
      publisher: { '@type': 'Organization', name: SITE_TITLE, url: site.href },
      datePublished: publishedTime,
      dateModified: modifiedTime ?? publishedTime,
      keywords: tags.join(', '),
      image: imageUrl.href
    }
  : { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_TITLE, description: SITE_DESCRIPTION, url: site.href, inLanguage: 'ko-KR' };
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {NAVER_SITE_VERIFICATION && <meta name="naver-site-verification" content={NAVER_SITE_VERIFICATION} />}
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#fffaf3" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" href={new URL('/rss.xml', site).href} title={`${SITE_TITLE} RSS`} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    {GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId);
          // Track affiliate outbound clicks (Coupang Partners) as a GA4 event.
          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a.aff-link') : null;
            if (!a) return;
            gtag('event', 'affiliate_click', { link_url: a.href, page_path: location.pathname, transport_type: 'beacon' });
          }, true);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="shell nav-shell">
        <a class="brand" href="/" aria-label={`${SITE_TITLE} 홈`}>
          <span class="brand-mark" aria-hidden="true">pick</span>
          <span class="brand-text"><strong>{SITE_TITLE}</strong><small>고르기 전에 보는 상품 노트</small></span>
        </a>
        <nav class="site-nav" aria-label="주요 메뉴">
          {NAV_ITEMS.map((item) => (
            <a href={item.href} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <strong>{SITE_TITLE}</strong>
          <p>구매 기준, 사양, 공개된 구매 후기를 함께 보고 정리합니다. 가격과 재고는 바뀌므로 구매 전 판매 페이지에서 다시 확인하세요.</p>
          <p class="footer-note">이 사이트의 상품 링크는 쿠팡 파트너스 제휴 링크이며, 구매 시 일정액의 수수료를 받을 수 있습니다.</p>
        </div>
        <nav aria-label="푸터 메뉴">
          <a href="/about/">소개·제휴 고지</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
